{
  "ConnectionStrings": {
    "CCSDb": "Server=localhost,1433;Database=ccs;Integrated Security=True;TrustServerCertificate=True;Encrypt=False"
  },
  "Jwt": {
    "Issuer": "CCS.Entities.Api",
    "Audience": "ccs-entities-web",
    "ExpirationMinutes": 60,
    "ClockSkewMinutes": 1
  },
  "Cors": {
    "Origins": "http://localhost:4200"
  },
  "PasswordHashing": {
    "IterationCount": 600000
  },
  "OpenApi": {
    "Title": "API CCS — Entidades"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/api-.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
